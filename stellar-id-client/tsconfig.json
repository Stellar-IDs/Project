{
  "compilerOptions": {
    "target": "ES2022",
    // DOM: the SDK targets browsers as well as Node (and the vendored
    // src/generated bindings reference window).
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Unused-variable checks are enforced by ESLint (error level) on
    // hand-written code instead: the vendored src/generated bindings ship
    // unused imports from the CLI generator, which tsc cannot ignore per-file.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "test", "tsup.config.ts"]
}
